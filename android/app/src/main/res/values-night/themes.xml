<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for night mode -->
    <style name="Base.Theme.QuranTajik" parent="Theme.MaterialComponents.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">#FFD0BCFF</item>
        <item name="colorPrimaryVariant">#FFB69DF8</item>
        <item name="colorOnPrimary">#FF381E72</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#FF4AE8D4</item>
        <item name="colorSecondaryVariant">#FF4AE8D4</item>
        <item name="colorOnSecondary">#FF00382F</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Surface colors -->
        <item name="colorSurface">#FF1C1B1F</item>
        <item name="colorOnSurface">#FFE6E1E5</item>
        <item name="colorSurfaceVariant">#FF49454F</item>
        <item name="colorOnSurfaceVariant">#FFCAC4D0</item>
        <!-- Background colors -->
        <item name="android:colorBackground">#FF1C1B1F</item>
        <item name="colorOnBackground">#FFE6E1E5</item>
        <!-- Error colors -->
        <item name="colorError">#FFF2B8B5</item>
        <item name="colorOnError">#FF601410</item>
        <!-- Window background -->
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Full screen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources> 