<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.QuranTajik" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryVariant">#FF3700B3</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#FF03DAC5</item>
        <item name="colorSecondaryVariant">#FF018786</item>
        <item name="colorOnSecondary">#FF000000</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Material 3 specific attributes -->
        <item name="materialColorPrimary">#FF6200EE</item>
        <item name="materialColorPrimaryContainer">#FFE8DEF8</item>
        <item name="materialColorOnPrimary">#FFFFFFFF</item>
        <item name="materialColorOnPrimaryContainer">#FF21005D</item>
        <item name="materialColorSecondary">#FF03DAC5</item>
        <item name="materialColorSecondaryContainer">#FFCCFBF1</item>
        <item name="materialColorOnSecondary">#FF000000</item>
        <item name="materialColorOnSecondaryContainer">#FF002020</item>
        <item name="materialColorSurface">#FFFFFBFE</item>
        <item name="materialColorOnSurface">#FF1C1B1F</item>
        <item name="materialColorSurfaceVariant">#FFE7E0EC</item>
        <item name="materialColorOnSurfaceVariant">#FF49454F</item>
        <item name="materialColorOutline">#FF79747E</item>
        <!-- Window background -->
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Full screen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources> 