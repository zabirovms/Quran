<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.QuranTajik" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryVariant">#FF3700B3</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">#FF03DAC5</item>
        <item name="colorSecondaryVariant">#FF018786</item>
        <item name="colorOnSecondary">#FF000000</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Material 3 specific attributes -->
        <item name="android:colorPrimary">#FF6200EE</item>
        <item name="android:colorPrimaryContainer">#FFE8DEF8</item>
        <item name="android:colorOnPrimary">#FFFFFFFF</item>
        <item name="android:colorOnPrimaryContainer">#FF21005D</item>
        <item name="android:colorSecondary">#FF03DAC5</item>
        <item name="android:colorSecondaryContainer">#FFCCFBF1</item>
        <item name="android:colorOnSecondary">#FF000000</item>
        <item name="android:colorOnSecondaryContainer">#FF002020</item>
        <item name="android:colorSurface">#FFFFFBFE</item>
        <item name="android:colorOnSurface">#FF1C1B1F</item>
        <item name="android:colorSurfaceVariant">#FFE7E0EC</item>
        <item name="android:colorOnSurfaceVariant">#FF49454F</item>
        <item name="android:colorOutline">#FF79747E</item>
        <!-- Window background -->
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Full screen -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources> 